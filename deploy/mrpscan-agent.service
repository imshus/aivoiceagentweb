# systemd unit for the MRPscan agent (see README "Run on AWS").
# Install: /etc/systemd/system/mrpscan-agent.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now mrpscan-agent
# Adjust User / paths if the checkout is not /home/ubuntu/aivoiceagentweb.

[Unit]
Description=MRPscan Software voice agent (browser page + outbound Vobiz calls)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/aivoiceagentweb
# Only Caddy talks to the app; it binds to localhost.
Environment=HTTP_HOST=127.0.0.1
Environment=HTTP_PORT=5000
Environment=PYTHONUNBUFFERED=1
# One process, one worker: call state, CRM sessions and the Vobiz webhooks
# all live in this process (README "Capacity").
ExecStart=/home/ubuntu/aivoiceagentweb/.venv/bin/python main.py
Restart=always
RestartSec=3
# On stop the app hangs up every live call over Vobiz REST before exiting.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
