# ---- Android app (read at build time by app/build.gradle) ----
# Only these two keys are read. The server's own .env (API keys) is never
# touched by the app build, and the APK holds no keys: it shows the console
# page the agent server serves, exactly as a browser would.

# Name under the phone icon.
APP_NAME=MRPscan Agent
# The agent server — the same address you open in a browser. The app opens
# SERVER_URL/crm. It must be https: Android only lets a page use the
# microphone (the Record buttons) over https, or http://localhost for a test
# build over `adb reverse`.
SERVER_URL=https://voice.amitaash.com
