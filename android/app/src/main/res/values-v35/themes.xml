<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps under the status and navigation bars unless they
         opt out. The pages are not built for that, so keep the classic layout:
         bars painted in the app's colours, and the keyboard resizing the page. -->
    <style name="Theme.MRPscanAgent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
